<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.orlandol23</groupId>
        <artifactId>payout-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>payout-worker</artifactId>
    <name>payout-worker</name>
    <description>Asynchronous consumer: reads payout.requested; claims and settles from day 3</description>

    <dependencies>
        <!--
          The same wire contract jar payout-api produces against. One artifact,
          one definition of the event, and a rename that breaks the consumer
          breaks it at compile time in this build.
        -->
        <dependency>
            <groupId>io.github.orlandol23</groupId>
            <artifactId>payout-contracts</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
          spring-boot-starter-web is here because the worker exposes an HTTP
          health endpoint for container orchestrator probes and, from day 4, a
          Prometheus scrape endpoint. It serves no business traffic.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Version managed by the Spring Boot BOM in the aggregator POM. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!--
          JDBC, and deliberately not JPA. The worker reaches the payouts table
          through one conditional UPDATE and nothing else, so it needs a
          DataSource and a JdbcClient, not a persistence context and an entity
          it could accidentally save. Leaving spring-boot-starter-data-jpa off
          this classpath is what enforces the boundary the README describes:
          there is no entity here to misuse, and no Flyway either, because the
          API owns the schema and migrates it on start.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- An in-JVM KRaft broker, so the listener is tested without Docker. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
