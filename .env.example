# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Every value is blank on purpose. Leaving a blank makes docker-compose.yml and
# application.yml fall back to their local development defaults, which is what
# you want on a laptop. Deployed environments set these explicitly, and on day 5
# they come from AWS Secrets Manager rather than from a file at all.

# --- PostgreSQL (docker-compose) ---------------------------------------------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# --- payout-api ---------------------------------------------------------------
PAYOUT_API_PORT=
PAYOUT_DB_URL=
PAYOUT_DB_USERNAME=
PAYOUT_DB_PASSWORD=
PAYOUT_DB_POOL_SIZE=

# --- payout-worker -------------------------------------------------------------
PAYOUT_WORKER_PORT=

# --- shared ---------------------------------------------------------------------
PAYOUT_LOG_LEVEL=

# --- day 2: Kafka ---------------------------------------------------------------
# KAFKA_BOOTSTRAP_SERVERS=

# --- day 4: LLM endpoint --------------------------------------------------------
# Never commit a real key. This is read from the environment at runtime.
# ANTHROPIC_API_KEY=
