# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Every value is blank on purpose. Leaving a blank makes docker-compose.yml and
# application.yml fall back to their local development defaults, which is what
# you want on a laptop. Deployed environments set these explicitly, and on day 5
# they come from AWS Secrets Manager rather than from a file at all.

# --- PostgreSQL (docker-compose) ---------------------------------------------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# --- payout-api ---------------------------------------------------------------
PAYOUT_API_PORT=
PAYOUT_DB_URL=
PAYOUT_DB_USERNAME=
PAYOUT_DB_PASSWORD=
PAYOUT_DB_POOL_SIZE=

# --- payout-worker -------------------------------------------------------------
PAYOUT_WORKER_PORT=
# The worker reads and claims from the same database payout-api writes to. Blank
# means the same local defaults; it never runs the migrations, the API does.
# Reuses PAYOUT_DB_URL / PAYOUT_DB_USERNAME / PAYOUT_DB_PASSWORD above.
#
# How many settlement attempts a payout gets before it is dead lettered.
PAYOUT_WORKER_MAX_ATTEMPTS=
# How long a claimed row may stay locked before another worker may reclaim it.
PAYOUT_WORKER_STALE_LOCK=
# The claim scan: how often it runs, how many rows it takes, and whether it runs
# at all. It is what picks up due retries, stale locks and rows whose
# payout.requested event was never published.
PAYOUT_WORKER_POLL_INTERVAL=
PAYOUT_WORKER_POLL_BATCH_SIZE=
PAYOUT_WORKER_POLL_ENABLED=
# The simulated provider: how long a settlement call takes, and which amounts
# and currency trigger which failure. See the failure mode table in the README.
PAYOUT_WORKER_SETTLEMENT_LATENCY=
PAYOUT_WORKER_SETTLEMENT_TRANSIENT_CENTS=
PAYOUT_WORKER_SETTLEMENT_PERMANENT_CENTS=
PAYOUT_WORKER_SETTLEMENT_REJECTED_CURRENCY=

# --- shared ---------------------------------------------------------------------
PAYOUT_LOG_LEVEL=

# --- Kafka ----------------------------------------------------------------------
# Where payout-api and payout-worker look for the broker. Blank means
# localhost:9092, which is the HOST listener docker-compose.yml advertises.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_PORT=
KAFKA_UI_PORT=

# --- day 4: LLM endpoint --------------------------------------------------------
# Never commit a real key. This is read from the environment at runtime.
# ANTHROPIC_API_KEY=
